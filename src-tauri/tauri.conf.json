{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Cove Turbo",
  "version": "0.1.0",
  "identifier": "com.aicove.turbo",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI Cove Turbo",
        "width": 1180,
        "height": 800,
        "minWidth": 360,
        "minHeight": 620,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
